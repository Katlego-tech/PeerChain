# ── Auth ──
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-32-chars-long-change-in-production

# ── Solana ──
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
